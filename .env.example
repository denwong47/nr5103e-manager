# Build mode for the Docker image: "release" (uvicorn) or "dev" (fastapi dev --reload)
MODE=release

# NR5103E admin credentials (required)
NR5103E_HOST=192.168.1.1
NR5103E_USERNAME=admin
NR5103E_PASSWORD=

# Connectivity checks
PING_TARGETS=1.1.1.1,8.8.8.8
PING_INTERVAL=60
PING_TIMEOUT=15
# PING_SOURCE=

# Reboot trigger: must be a subset of PING_TARGETS
MONITORED_IPS=1.1.1.1,8.8.8.8
MONITORING_INTERVAL=150
